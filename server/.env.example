# Copy this file to server/.env and adjust as needed.

# Port the contact API listens on.
PORT=5000

# Comma-separated list of origins allowed to POST the contact form.
# Add your production domain here when you deploy.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Secret for reading submissions via GET /api/messages.
# Leave empty to keep the admin endpoints disabled.
ADMIN_TOKEN=

# Optional: override where the SQLite file lives.
# DB_PATH=./server/data/portfolio.db
